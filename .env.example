# Root .env file for Docker Compose.
# Docker Compose reads this file automatically from the project root.
# These values are local-development defaults, not production secrets.

POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow

RABBITMQ_DEFAULT_USER=orderflow
RABBITMQ_DEFAULT_PASS=orderflow

ADMIN_USERNAME=admin
ADMIN_PASSWORD=orderflow-admin
JWT_SECRET=dev-only-change-me

ORDERFLOW_HOST=orderflow.app.localhost
