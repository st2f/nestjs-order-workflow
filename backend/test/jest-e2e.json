{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-e2e-env.js"],
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/jest-shims/uuid.cjs"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
